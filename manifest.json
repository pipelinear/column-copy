{
  "manifest_version": 3,
  "name": "Column Copy",
  "version": "1.3.0",
  "description": "Drag a horizontal range and copy its text from the full height of a webpage.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Column Copy — select a column",
    "default_icon": { "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Select a column to copy"
    },
    "read-page": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "Read the selected column into the output preview"
    }
  }
}
